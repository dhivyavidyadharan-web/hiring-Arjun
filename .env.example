# --- Claude (scoring, briefs, invite drafts) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-5
CLAUDE_MODEL=claude-opus-5

# --- Supabase (candidate store). Run supabase/schema.sql first. ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Resend (email delivery, only fires when Arjun clicks Send) ---
RESEND_API_KEY=re_...
# Must be a verified domain in Resend. For testing, onboarding@resend.dev works
# but can only deliver to your own Resend account email.
EMAIL_FROM="Kargo Hiring <onboarding@resend.dev>"
EMAIL_REPLY_TO=arjun@kargo.example
# Optional: when set, EVERY email goes to this address instead of the candidate (demo / class mode)
EMAIL_TEST_RECIPIENT=

# Name used to sign the interview-invite email. Never used in rejection emails.
INVITE_SIGNATURE="Arjun Mehta, Founder, Kargo"

# --- Dashboard login (single user: Arjun) ---
ADMIN_PASSWORD=change-me
# Any long random string; used to sign the session cookie
SESSION_SECRET=replace-with-32+-random-characters
